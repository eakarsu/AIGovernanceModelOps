{
  "name": "ai-governance-modelops",
  "version": "1.0.0",
  "description": "AI Governance / Model Ops platform (EU AI Act, NIST AI RMF, ISO 42001)",
  "private": true,
  "scripts": {
    "start": "bash start.sh",
    "backend": "cd backend && npm start",
    "frontend": "cd frontend && npm start",
    "bootstrap": "bash scripts/bootstrap.sh",
    "migrate": "bash scripts/migrate.sh",
    "seed:demo": "bash scripts/seed-demo.sh",
    "test:unit": "node --test backend/tests/*.test.js",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
